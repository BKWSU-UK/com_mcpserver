{
    "name": "joomla/com_mcpserver",
    "description": "Model Context Protocol server component for Joomla",
    "type": "joomla-component",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.10",
        "monolog/monolog": "^3.9",
        "justinrainbow/json-schema": "^5.3",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Joomla\\Component\\Mcpserver\\Administrator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joomla\\Component\\Mcpserver\\Tests\\": "../tests/"
        }
    },
    "config": {
        "vendor-dir": "vendor"
    }
}
